# Copy to .env.local and fill in real values. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=<SUPABASE_URL>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<SUPABASE_ANON_KEY>
NEXT_PUBLIC_WEB3FORMS_KEY=<WEB3FORMS_KEY>

# Optional: read only GitHub token for portfolio.json manifests and devlogs (see README.md).
# Uncomment and fill in; while it is unset, builds skip the manifests with a warning.
# GITHUB_TOKEN=<GITHUB_TOKEN>
